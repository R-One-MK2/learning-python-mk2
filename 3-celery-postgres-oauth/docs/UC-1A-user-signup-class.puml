@startuml Class Diagram - Use Case UC-01A (Sign Up)
skinparam classAttributeIconSize 0

package "app.api.v1" {
    class AuthRouter {
        +signup(payload: UserSignUpRequest, db: AsyncSession): UserResponseEnvelope
    }
}

package "app.domain.auth.schemas" {
    class UserSignUpRequest <<Pydantic.BaseModel>> {
        +email: EmailStr
        +password: str
    }
    class UserResponseEnvelope <<Pydantic.BaseModel>> {
        +id: int
        +email: EmailStr
        +is_active: bool
    }
}

package "app.domain.auth.services" {
    class AuthUseCaseService {
        +register_new_user(email: str, plain_pass: str): User
    }
    class AuthCryptoService <<Stateless>> {
        +hash_password(password: str): str
        +verify_password(plain: str, hashed: str): bool
    }
}

package "app.domain.auth.repository" {
    class AuthRepository {
        -db: AsyncSession
        +__init__(db: AsyncSession)
        +find_by_email(email: str): User | None
        +save_user(user: User): User
    }
}

package "app.domain.auth.models" {
    class User <<SQLAlchemy.Base>> {
        +id: int
        +email: str
        +hashed_password: str
        +is_active: bool
        +created_at: datetime
    }
}

' Standard Unidirectional Relationships
AuthRouter ..> UserSignUpRequest : "receives"
AuthRouter ..> UserResponseEnvelope : "returns"
AuthRouter --> AuthUseCaseService : "delegates to"

AuthUseCaseService --> AuthCryptoService : "invokes"
AuthUseCaseService --> AuthRepository : "persists via"
AuthUseCaseService ..> User : "instantiates"

AuthRepository "1" *-- "1" User : "manages"
@enduml